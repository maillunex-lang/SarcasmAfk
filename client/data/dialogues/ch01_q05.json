{
  "dialogue_id": "CH01-Q05",
  "quest_id": "CH01-Q05",
  "title": "Архив с характером",
  "lines": [
    {
      "id": "01",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Почему книги убегают?"
    },
    {
      "id": "02",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Им приказали повысить мобильность библиотечного фонда."
    },
    {
      "id": "03",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Вы хранитель?"
    },
    {
      "id": "04",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Последний. Остальных перевели в электронный формат."
    },
    {
      "id": "05",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "То есть?"
    },
    {
      "id": "06",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Они живут в трёх папках и требуют пароль."
    },
    {
      "id": "07",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Что делает Печать?"
    },
    {
      "id": "08",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Она заставляет реальность подчиняться словам."
    },
    {
      "id": "09",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "И как её остановить?"
    },
    {
      "id": "10",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Нарушить одиннадцать запретов и заполнить заявление."
    },
    {
      "id": "11",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Я уже ненавижу вторую часть плана."
    }
  ]
}
