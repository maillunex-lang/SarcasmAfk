{
  "dialogue_id": "CH01-Q11",
  "quest_id": "CH01-Q11",
  "title": "Последнее окошко",
  "lines": [
    {
      "id": "01",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Где лестница?"
    },
    {
      "id": "02",
      "speaker_id": "NPC_ELEVATOR",
      "speaker": "Лифт",
      "text": "Самовольное изменение высоты запрещено."
    },
    {
      "id": "03",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Как подняться?"
    },
    {
      "id": "04",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Объявим подъём административным понижением."
    },
    {
      "id": "05",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Это не имеет смысла."
    },
    {
      "id": "06",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Именно поэтому сработает."
    },
    {
      "id": "07",
      "speaker_id": "E30",
      "speaker": "Начальник",
      "text": "Приём завершён."
    },
    {
      "id": "08",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Мы пришли отменять конец света."
    },
    {
      "id": "09",
      "speaker_id": "E30",
      "speaker": "Начальник",
      "text": "Только по решению вышестоящей инстанции."
    },
    {
      "id": "10",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Верховного Регламентора?"
    },
    {
      "id": "11",
      "speaker_id": "E30",
      "speaker": "Начальник",
      "text": "Да. Вы нарушили порядок."
    }
  ]
}
