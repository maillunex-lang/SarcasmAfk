{
  "dialogue_id": "CH01-Q10",
  "quest_id": "CH01-Q10",
  "title": "Город по форме 404-Б",
  "lines": [
    {
      "id": "01",
      "speaker_id": "NPC_SPEAKER",
      "speaker": "Громкоговоритель",
      "text": "Уфа признана временно недействительным населённым пунктом."
    },
    {
      "id": "02",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Что значит «недействительным»?"
    },
    {
      "id": "03",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Улица только что исчезла."
    },
    {
      "id": "04",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Город сочли недостаточно оптимальным."
    },
    {
      "id": "05",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "А жители?"
    },
    {
      "id": "06",
      "speaker_id": "NPC_SPEAKER",
      "speaker": "Громкоговоритель",
      "text": "Вопрос будет рассмотрен после процедуры."
    },
    {
      "id": "07",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Если цикл завершится, обычное восстановление станет невозможным."
    },
    {
      "id": "08",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Значит, заканчиваем прямо сейчас."
    }
  ]
}
