{
  "dialogue_id": "CH01-Q09",
  "quest_id": "CH01-Q09",
  "title": "Печать без права возврата",
  "lines": [
    {
      "id": "01",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Фрагмент Печати Великого Порядка."
    },
    {
      "id": "02",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Он питает все терминалы."
    },
    {
      "id": "03",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Забираем."
    },
    {
      "id": "04",
      "speaker_id": "NPC_MAGIC",
      "speaker": "Магический голос",
      "text": "Требуется подтверждение права собственности."
    },
    {
      "id": "05",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Кто собственник?"
    },
    {
      "id": "06",
      "speaker_id": "NPC_MAGIC",
      "speaker": "Магический голос",
      "text": "Не установлено."
    },
    {
      "id": "07",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Кто подтвердит?"
    },
    {
      "id": "08",
      "speaker_id": "NPC_MAGIC",
      "speaker": "Магический голос",
      "text": "Собственник."
    },
    {
      "id": "09",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Он не сопротивляется. Он распознал наш отряд."
    },
    {
      "id": "10",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Точнее, волю, направляющую отряд."
    }
  ]
}
