{
  "dialogue_id": "CH01-Q04",
  "quest_id": "CH01-Q04",
  "title": "Заявление на заявление",
  "lines": [
    {
      "id": "01",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Нам нужен доступ к архиву управляющих приказов."
    },
    {
      "id": "02",
      "speaker_id": "NPC_TERMINAL",
      "speaker": "Терминал",
      "text": "Требуется форма 404-Б."
    },
    {
      "id": "03",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Выдайте её."
    },
    {
      "id": "04",
      "speaker_id": "NPC_TERMINAL",
      "speaker": "Терминал",
      "text": "Для выдачи нужна форма 404-А."
    },
    {
      "id": "05",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Где взять 404-А?"
    },
    {
      "id": "06",
      "speaker_id": "NPC_TERMINAL",
      "speaker": "Терминал",
      "text": "Форма упразднена приказом 404-В."
    },
    {
      "id": "07",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "А приказ где?"
    },
    {
      "id": "08",
      "speaker_id": "NPC_TERMINAL",
      "speaker": "Терминал",
      "text": "В архиве, доступ к которому требует 404-Б."
    },
    {
      "id": "09",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Я официально против системы."
    },
    {
      "id": "10",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Смотри на подпись: «Верховный Регламентор». Это не случайный сбой."
    }
  ]
}
