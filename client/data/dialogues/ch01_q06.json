{
  "dialogue_id": "CH01-Q06",
  "quest_id": "CH01-Q06",
  "title": "Неправильная подпись",
  "lines": [
    {
      "id": "01",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Оригинал: «Упростить обслуживание жителей»."
    },
    {
      "id": "02",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "А подделка?"
    },
    {
      "id": "03",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "«Упростить жителей для обслуживания»."
    },
    {
      "id": "04",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Два слова местами?"
    },
    {
      "id": "05",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "В магии одной запятой хватит для нашествия драконов."
    },
    {
      "id": "06",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Подпись подлинная."
    },
    {
      "id": "07",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Значит, кто-то сделал это специально."
    },
    {
      "id": "08",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "И тщательно проверил орфографию."
    },
    {
      "id": "09",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Отмена возможна только через центральный терминал."
    }
  ]
}
