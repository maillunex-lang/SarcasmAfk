{
  "dialogue_id": "CH01-Q08",
  "quest_id": "CH01-Q08",
  "title": "Сбой по инструкции",
  "lines": [
    {
      "id": "01",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Отключаю питание."
    },
    {
      "id": "02",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Сработало?"
    },
    {
      "id": "03",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Нет. Система получила приказ работать при любых обстоятельствах."
    },
    {
      "id": "04",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Даже без электричества?"
    },
    {
      "id": "05",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Особенно без электричества."
    },
    {
      "id": "06",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Удобно нарушать законы природы."
    },
    {
      "id": "07",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Внизу находится фрагмент Печати."
    },
    {
      "id": "08",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Магический камень, который заставляет бюрократию работать? Ужас."
    }
  ]
}
