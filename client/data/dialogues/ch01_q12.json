{
  "dialogue_id": "CH01-Q12",
  "quest_id": "CH01-Q12",
  "title": "Справка о спасении",
  "lines": [
    {
      "id": "01",
      "speaker_id": "E30",
      "speaker": "Начальник",
      "text": "Ваше присутствие нарушает утверждённый порядок."
    },
    {
      "id": "02",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Мы пришли его исправить."
    },
    {
      "id": "03",
      "speaker_id": "E30",
      "speaker": "Начальник",
      "text": "Порядок не нуждается в исправлении."
    },
    {
      "id": "04",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Он уничтожает город!"
    },
    {
      "id": "05",
      "speaker_id": "E30",
      "speaker": "Начальник",
      "text": "В соответствии с планом оптимизации."
    },
    {
      "id": "06",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Вы неверно истолковали назначение Печати."
    },
    {
      "id": "07",
      "speaker_id": "E30",
      "speaker": "Начальник",
      "text": "Я не толкую. Я исполняю."
    },
    {
      "id": "08",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Тогда исполни вот это!"
    },
    {
      "id": "09",
      "speaker_id": "E30",
      "speaker": "Начальник",
      "text": "Невозможно... мой регламент безупречен..."
    },
    {
      "id": "10",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Поэтому он и проиграл. Вы предусмотрели всё, кроме отказа играть по вашим правилам."
    },
    {
      "id": "11",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Отключаю управляющий контур."
    },
    {
      "id": "12",
      "speaker_id": "NPC_SPEAKER",
      "speaker": "Громкоговоритель",
      "text": "Конец света отменён. Оцените качество услуги."
    },
    {
      "id": "13",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Одну звезду."
    },
    {
      "id": "14",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Почему не ноль?"
    },
    {
      "id": "15",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "У них наверняка нет такой кнопки."
    },
    {
      "id": "16",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Печать разделена на части. Следующий сигнал идёт из Стерлитамака."
    },
    {
      "id": "17",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Надеюсь, там нет терминалов."
    },
    {
      "id": "18",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Там завод, производящий больше продукции, чем существует сырья."
    },
    {
      "id": "19",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Звучит многообещающе."
    },
    {
      "id": "20",
      "speaker_id": "NPC_UNKNOWN",
      "speaker": "Неизвестный голос",
      "text": "Регламентор, система Уфы отключена."
    },
    {
      "id": "21",
      "speaker_id": "NPC_REGLAMENTOR",
      "speaker": "Регламентор",
      "text": "Значит, кто-то научился нарушать идеальный порядок. Внесите их в план."
    }
  ]
}
