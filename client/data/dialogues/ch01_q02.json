{
  "dialogue_id": "CH01-Q02",
  "quest_id": "CH01-Q02",
  "title": "Без печати не герой",
  "lines": [
    {
      "id": "01",
      "speaker_id": "NPC_GOLEM",
      "speaker": "Голем",
      "text": "Предъявите удостоверение уполномоченного спасителя."
    },
    {
      "id": "02",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Я спасаю людей, а не оформляю отпуск."
    },
    {
      "id": "03",
      "speaker_id": "NPC_GOLEM",
      "speaker": "Голем",
      "text": "Спасательные действия без удостоверения запрещены."
    },
    {
      "id": "04",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "А если я спасу тебя от собственного начальства?"
    },
    {
      "id": "05",
      "speaker_id": "NPC_GOLEM",
      "speaker": "Голем",
      "text": "Ошибка классификации. Запрос передан на повторную проверку."
    },
    {
      "id": "06",
      "speaker_id": "NPC_SPEAKER",
      "speaker": "Громкоговоритель",
      "text": "Выявлено использование здравого смысла без допуска."
    },
    {
      "id": "07",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Теперь и это преступление?"
    },
    {
      "id": "08",
      "speaker_id": "NPC_SPEAKER",
      "speaker": "Громкоговоритель",
      "text": "Вопрос направлен на согласование."
    }
  ]
}
