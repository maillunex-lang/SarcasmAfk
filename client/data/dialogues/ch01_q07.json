{
  "dialogue_id": "CH01-Q07",
  "quest_id": "CH01-Q07",
  "title": "Инспектор не одобряет",
  "lines": [
    {
      "id": "01",
      "speaker_id": "E20",
      "speaker": "Инспектор",
      "text": "Назовите цель визита."
    },
    {
      "id": "02",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Спасти Уфу."
    },
    {
      "id": "03",
      "speaker_id": "E20",
      "speaker": "Инспектор",
      "text": "Причина спасения?"
    },
    {
      "id": "04",
      "speaker_id": "H01",
      "speaker": "Каэрон",
      "text": "Она исчезает!"
    },
    {
      "id": "05",
      "speaker_id": "E20",
      "speaker": "Инспектор",
      "text": "Это описание состояния, не причина."
    },
    {
      "id": "06",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "У нас доказательства незаконного приказа."
    },
    {
      "id": "07",
      "speaker_id": "E20",
      "speaker": "Инспектор",
      "text": "Нужен допуск на обнаружение нарушений."
    },
    {
      "id": "08",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "По древнему параграфу 17 допуск не нужен при нарушении ведомством собственных правил."
    },
    {
      "id": "09",
      "speaker_id": "E20",
      "speaker": "Инспектор",
      "text": "Такого параграфа нет!"
    },
    {
      "id": "10",
      "speaker_id": "H03",
      "speaker": "Эльдарион",
      "text": "Я его вчера восстановил."
    },
    {
      "id": "11",
      "speaker_id": "E20",
      "speaker": "Инспектор",
      "text": "Ваше заявление удовлетворено... в течение тридцати рабочих столетий."
    },
    {
      "id": "12",
      "speaker_id": "H02",
      "speaker": "Вейриса",
      "text": "Просто отдайте ключ."
    }
  ]
}
