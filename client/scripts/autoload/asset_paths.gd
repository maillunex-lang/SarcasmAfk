static func equipment_icon(icon_asset_id: String) -> String:
	if icon_asset_id == "":
		return ICON_INVENTORY
	var path := "res://assets/ui/equipment/%s.jpg" % icon_asset_id
	if ResourceLoader.exists(path):
		return path
	# TEMP fallback without extension mismatch
	path = "res://assets/ui/equipment/%s.png" % icon_asset_id
	if ResourceLoader.exists(path):
		return path
	return ICON_INVENTORY


static func gacha_frame(rarity: String) -> String:
	var key := rarity.strip_edges().to_upper()
	if key == "":
		key = "N"
	var path := "res://assets/ui/gacha/gacha_frame_%s.png" % key.to_lower()
	if ResourceLoader.exists(path):
		return path
	return "res://assets/ui/gacha/gacha_frame_n.png"


static func shop_icon_for_category(category: String) -> String:
	match category:
		"diamonds":
			return SHOP_ICON_DIAMONDS
		"resource_packs":
			return SHOP_ICON_RESOURCES
		"growth_packs":
			return SHOP_ICON_GROWTH
		"daily", "weekly", "monthly":
			return SHOP_ICON_DEAL
		"cosmetic":
			return SHOP_ICON_COSMETIC
		"vip":
			return SHOP_ICON_VIP
		_:
			return SHOP_ICON_DEAL


static func tex(path: String) -> Texture2D:
	var res = load(path)
	if res is Texture2D:
		return res
	push_warning("Asset missing or not Texture2D: %s" % path)
	return null


static func location_layer(loc_id: String, layer: String) -> String:
	return "res://assets/locations/%s/loc_%s_%s.jpg" % [loc_id, loc_id, layer]


static func arena_floor_for(loc_id: String) -> String:
	var path := "res://assets/arenas/ARENA-%s/arena_%s_floor.jpg" % [loc_id, loc_id]
	if ResourceLoader.exists(path):
		return path
	return ARENA_FLOOR


static func hero_portrait(hero_id: String) -> String:
	return "res://assets/characters/%s/%s_portrait.jpg" % [hero_id, hero_id]


static func hero_full(hero_id: String) -> String:
	var path := "res://assets/characters/%s/%s_full.jpg" % [hero_id, hero_id]
	if ResourceLoader.exists(path):
		return path
	return hero_portrait(hero_id)


static func dialog_portrait_for(speaker_id: String) -> Texture2D:
	# H01–H36 dialog busts (TEMP for H13–H36 until Stage E).
	if speaker_id.begins_with("H"):
		var path := "res://assets/dialogs/dialog_portrait_%s.jpg" % speaker_id
		if ResourceLoader.exists(path):
			var t := tex(path)
			if t:
				return t
		var fallback := hero_portrait(speaker_id)
		if ResourceLoader.exists(fallback):
			return tex(fallback)
	match speaker_id:
		"NPC_TERMINAL":
			return tex("res://assets/dialogs/dialog_portrait_NPC_TERMINAL.jpg")
		_:
			return tex("res://assets/dialogs/dialog_portrait_NPC_TERMINAL.jpg")


static func combat_idle(unit_id: String) -> String:
	var path := "res://assets/combat/%s/%s_idle.png" % [unit_id, unit_id]
	if ResourceLoader.exists(path):
		return path
	return ""


static func enemy_concept(enemy_type: String) -> String:
	var path := "res://assets/enemies/%s/concept.jpg" % enemy_type
	if ResourceLoader.exists(path):
		return path
	path = "res://assets/enemies/%s/portrait.jpg" % enemy_type
	if ResourceLoader.exists(path):
		return path
	return ""


static func enemy_atlas(enemy_type: String, anim: String = "idle") -> String:
	var path := "res://assets/enemies/%s/atlases/%s.jpg" % [enemy_type, anim]
	if ResourceLoader.exists(path):
		return path
	path = "res://assets/enemies/%s/atlases/%s.png" % [enemy_type, anim]
	if ResourceLoader.exists(path):
		return path
	return ""


static func enemy_atlas_meta(enemy_type: String, anim: String = "idle") -> String:
	var path := "res://assets/enemies/%s/atlases/%s.json" % [enemy_type, anim]
	if ResourceLoader.exists(path):
		return path
	return ""


static func enemy_sprite_for_type(enemy_type: String) -> String:
	# Prefer a single-frame still for TextureRect / bestiary (not the full atlas strip).
	var combat := combat_idle(enemy_type)
	if combat != "":
		return combat
	var idle := "res://assets/enemies/%s/idle.jpg" % enemy_type
	if ResourceLoader.exists(idle):
		return idle
	var concept := enemy_concept(enemy_type)
	if concept != "":
		return concept
	# Last-resort legacy placeholders (should not hit after MONSTERS-CH01-001).
	return "res://assets/enemies/E01/E01_living_ticket.jpg"


